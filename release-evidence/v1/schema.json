    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "commitSha": {
          "$ref": "#/$defs/__schema2"
        },
        "dirty": {
          "type": "boolean"
        },
        "generatedAt": {
          "$ref": "#/$defs/__schema3"
        },
        "freshnessWindowHours": {
          "type": "number",
          "const": 24
        }
      },
      "required": [
        "commitSha",
        "dirty",
        "generatedAt",
        "freshnessWindowHours"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "__schema3": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "expected": {
          "type": "object",
          "properties": {
            "classification": {
              "type": "string",
              "const": "tested"
            },
            "web": {
              "$ref": "#/$defs/__schema5"
            },
            "api": {
              "$ref": "#/$defs/__schema5"
            },
            "jobs": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "classification",
            "web",
            "api",
            "jobs"
          ],
          "additionalProperties": false
        },
        "deployed": {
          "type": "object",
          "properties": {
            "classification": {
              "$ref": "#/$defs/__schema6"
            },
            "observedAt": {
              "$ref": "#/$defs/__schema7"
            },
            "source": {
              "$ref": "#/$defs/__schema8"
            },
            "scope": {
              "$ref": "#/$defs/__schema10"
            },
            "evidenceRefs": {
              "$ref": "#/$defs/__schema13"
            },
            "web": {
              "$ref": "#/$defs/__schema5"
            },
            "api": {
              "$ref": "#/$defs/__schema5"
            },
            "jobs": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "classification",
            "observedAt",
            "source",
            "scope",
            "evidenceRefs",
            "web",
            "api",
            "jobs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "expected",
        "deployed"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "tag": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tag",
        "digest"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "live",
        "synthetic",
        "tested",
        "blocked",
        "planned"
