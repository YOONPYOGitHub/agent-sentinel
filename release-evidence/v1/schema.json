{
  "$id": "https://agent-sentinel.example/schemas/release-evidence/v1/schema.json",
  "title": "Agent Sentinel sanitized release evidence manifest",
  "description": "Strict versioned release evidence. The repository validator additionally enforces cross-field contradictions.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "release": {
      "$ref": "#/$defs/__schema1"
    },
    "images": {
      "$ref": "#/$defs/__schema4"
    },
    "configuration": {
      "$ref": "#/$defs/__schema15"
    },
    "checks": {
      "$ref": "#/$defs/__schema17"
    },
    "liveValidations": {
      "$ref": "#/$defs/__schema23"
    },
    "connectors": {
      "$ref": "#/$defs/__schema30"
    },
    "oneRai": {
      "$ref": "#/$defs/__schema37"
    }
  },
  "required": [
    "schemaVersion",
    "release",
    "images",
    "configuration",
    "checks",
    "liveValidations",
    "connectors",
    "oneRai"
