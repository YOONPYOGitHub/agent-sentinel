          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema8": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema9"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema10": {
      "default": null,
      "anyOf": [
