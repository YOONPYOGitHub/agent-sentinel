          "enum": [
            "tested",
            "planned"
          ]
        },
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "keys": {
          "maxItems": 14,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema16"
          }
        }
      },
      "required": [
        "classification",
        "algorithm",
        "hash",
        "keys"
      ],
      "additionalProperties": false
