{
  "name": "@agent-sentinel/connector-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./demo-readiness": {
      "types": "./dist/demo-readiness.d.ts",
      "import": "./dist/demo-readiness.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/demo-readiness.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/demo-readiness.ts --format esm --dts --watch",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-sentinel/domain": "workspace:*",
    "zod": "^4.1.5"
  }
}
