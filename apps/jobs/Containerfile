FROM node:22-slim AS builder
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/domain/package.json packages/domain/
COPY packages/connector-sdk/package.json packages/connector-sdk/
COPY packages/graph-engine/package.json packages/graph-engine/
COPY packages/messaging/package.json packages/messaging/
COPY packages/persistence/package.json packages/persistence/
COPY packages/policy-engine/package.json packages/policy-engine/
COPY connectors/foundry/package.json connectors/foundry/
COPY connectors/entra-identity/package.json connectors/entra-identity/
COPY connectors/power-platform/package.json connectors/power-platform/
COPY connectors/agent365/package.json connectors/agent365/
COPY connectors/defender-cloud-apps/package.json connectors/defender-cloud-apps/
COPY connectors/manifest/package.json connectors/manifest/
COPY connectors/mock/package.json connectors/mock/
COPY apps/jobs/package.json apps/jobs/
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY connectors/ connectors/
COPY apps/jobs/ apps/jobs/
RUN pnpm --filter @agent-sentinel/domain build
RUN pnpm --filter @agent-sentinel/connector-sdk build
RUN pnpm --filter @agent-sentinel/graph-engine build
RUN pnpm --filter @agent-sentinel/messaging build
RUN pnpm --filter @agent-sentinel/persistence build
RUN pnpm --filter @agent-sentinel/policy-engine build
RUN pnpm --filter @agent-sentinel/foundry-connector build
RUN pnpm --filter @agent-sentinel/entra-identity-connector build
RUN pnpm --filter @agent-sentinel/power-platform-connector build
RUN pnpm --filter @agent-sentinel/agent365-connector build
RUN pnpm --filter @agent-sentinel/defender-cloud-apps-connector build
RUN pnpm --filter @agent-sentinel/manifest-connector build
RUN pnpm --filter @agent-sentinel/mock-connector build
RUN pnpm --filter @agent-sentinel/jobs build

FROM node:22-slim AS runtime
WORKDIR /app
RUN corepack enable
COPY --from=builder /workspace/package.json /workspace/pnpm-workspace.yaml /workspace/pnpm-lock.yaml ./
COPY --from=builder /workspace/apps/jobs/dist ./apps/jobs/dist/
COPY --from=builder /workspace/apps/jobs/package.json ./apps/jobs/
COPY --from=builder /workspace/packages/domain/dist ./packages/domain/dist/
COPY --from=builder /workspace/packages/domain/package.json ./packages/domain/
COPY --from=builder /workspace/packages/connector-sdk/dist ./packages/connector-sdk/dist/
COPY --from=builder /workspace/packages/connector-sdk/package.json ./packages/connector-sdk/
COPY --from=builder /workspace/packages/graph-engine/dist ./packages/graph-engine/dist/
COPY --from=builder /workspace/packages/graph-engine/package.json ./packages/graph-engine/
COPY --from=builder /workspace/packages/messaging/dist ./packages/messaging/dist/
COPY --from=builder /workspace/packages/messaging/package.json ./packages/messaging/
COPY --from=builder /workspace/packages/persistence/dist ./packages/persistence/dist/
COPY --from=builder /workspace/packages/persistence/package.json ./packages/persistence/
COPY --from=builder /workspace/packages/policy-engine/dist ./packages/policy-engine/dist/
COPY --from=builder /workspace/packages/policy-engine/package.json ./packages/policy-engine/
COPY --from=builder /workspace/connectors/foundry/dist ./connectors/foundry/dist/
COPY --from=builder /workspace/connectors/foundry/package.json ./connectors/foundry/
COPY --from=builder /workspace/connectors/entra-identity/dist ./connectors/entra-identity/dist/
COPY --from=builder /workspace/connectors/entra-identity/package.json ./connectors/entra-identity/
COPY --from=builder /workspace/connectors/power-platform/dist ./connectors/power-platform/dist/
COPY --from=builder /workspace/connectors/power-platform/package.json ./connectors/power-platform/
COPY --from=builder /workspace/connectors/agent365/dist ./connectors/agent365/dist/
COPY --from=builder /workspace/connectors/agent365/package.json ./connectors/agent365/
COPY --from=builder /workspace/connectors/defender-cloud-apps/dist ./connectors/defender-cloud-apps/dist/
COPY --from=builder /workspace/connectors/defender-cloud-apps/package.json ./connectors/defender-cloud-apps/
COPY --from=builder /workspace/connectors/manifest/dist ./connectors/manifest/dist/
COPY --from=builder /workspace/connectors/manifest/package.json ./connectors/manifest/
COPY --from=builder /workspace/connectors/mock/dist ./connectors/mock/dist/
COPY --from=builder /workspace/connectors/mock/package.json ./connectors/mock/
RUN pnpm install --frozen-lockfile --prod
USER node
CMD ["node", "apps/jobs/dist/worker.js"]
