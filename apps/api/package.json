    "@agent-sentinel/manifest-connector": "workspace:*",
    "@agent-sentinel/mock-connector": "workspace:*",
    "@agent-sentinel/persistence": "workspace:*",
    "@agent-sentinel/policy-engine": "workspace:*",
    "@agent-sentinel/power-platform-connector": "workspace:*",
    "@agent-sentinel/purview-connector": "workspace:*",
    "@agent-sentinel/scenarios": "workspace:*",
    "@azure/cosmos": "^4.4.0",
    "@azure/identity": "^4.11.1",
