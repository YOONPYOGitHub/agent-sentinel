{
  "name": "agent-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "auth:preflight": "pnpm --filter @agent-sentinel/scripts auth:preflight",
    "auth:registration-bootstrap": "pnpm --filter @agent-sentinel/scripts auth:registration-bootstrap",
    "auth:edge-preflight": "pnpm --filter @agent-sentinel/scripts auth:edge-preflight",
    "auth:deploy": "pnpm --filter @agent-sentinel/scripts auth:deploy",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @agent-sentinel/web test:e2e",
    "storybook": "pnpm --filter @agent-sentinel/ui storybook",
    "storybook:build": "pnpm --filter @agent-sentinel/ui storybook:build",
    "typecheck": "turbo run typecheck",
    "foundry:provision": "pnpm --filter @agent-sentinel/scripts provision-agents",
    "foundry:cleanup": "pnpm --filter @agent-sentinel/scripts cleanup-agents",
    "foundry:identity-pilot": "pnpm --filter @agent-sentinel/scripts foundry-identity-pilot",
    "foundry:validate": "pnpm --filter @agent-sentinel/scripts validate-live",
    "foundry:validate-onerai": "pnpm --filter @agent-sentinel/scripts validate-onerai-live",
    "foundry:validate-telemetry": "pnpm --filter @agent-sentinel/scripts validate-telemetry-live",
    "auth:validate-live": "pnpm --filter @agent-sentinel/scripts validate-auth-live",
    "release-evidence:generate": "pnpm --filter @agent-sentinel/scripts release-evidence:generate",
    "release-evidence:schema": "pnpm --filter @agent-sentinel/scripts release-evidence:schema",
    "release-evidence:schema:check": "pnpm --filter @agent-sentinel/scripts release-evidence:schema:check",
    "release-evidence:validate": "pnpm --filter @agent-sentinel/scripts release-evidence:validate",
    "release-review:dry-run": "pnpm --filter @agent-sentinel/scripts release-review:dry-run",
    "release-review:schema": "pnpm --filter @agent-sentinel/scripts release-review:schema",
    "release-review:schema:check": "pnpm --filter @agent-sentinel/scripts release-review:schema:check",
    "release-review:validate": "pnpm --filter @agent-sentinel/scripts release-review:validate",
    "manifest:validate": "pnpm --filter @agent-sentinel/tools validate-manifest",
    "manifest:scan": "pnpm --filter @agent-sentinel/tools scan-manifest",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release-readiness:verify": "pnpm --filter @agent-sentinel/scripts verify-release-readiness",
    "demo:verify": "pnpm release-readiness:verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "@azure/core-auth": "^1.10.1",
    "@azure/identity": "^4.11.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  }
}
