# Connector selection; mock is the default.
AGENT_SENTINEL_CONNECTOR=mock
# Required when AGENT_SENTINEL_CONNECTOR=foundry.
FOUNDRY_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/example
FOUNDRY_TENANT_ID=00000000-0000-0000-0000-000000000000
FOUNDRY_ENVIRONMENT=validation
# Optional multi-source JSON. Each entry has id, name, projectEndpoint, tenantId,
# environment, and optional credential. Use credential.mode=federated-app with
# clientId for cross-tenant secretless workload identity federation.
FOUNDRY_SOURCES_JSON=
# Stable aggregate boundary used by Cosmos regardless of source tenant count.
AGENT_SENTINEL_ESTATE_ID=default
AGENT_SENTINEL_TENANT_ID=
AGENT_SENTINEL_ENVIRONMENT=
# Dedicated immutable custom-manifest ingestion history.
COSMOS_MANIFEST_INGESTIONS_CONTAINER=manifest-ingestions

# Optional read-only runtime telemetry connector. Live runtime analysis stays
# typed unknown unless all three required values are injected.
AZURE_MONITOR_WORKSPACE_ID=
AZURE_MONITOR_TENANT_ID=
AZURE_MONITOR_ENVIRONMENT=
# Optional multi-source JSON. Source ids must match Foundry source ids and bind
# each aggregate agent to one workspace, source tenant, and environment.
AZURE_MONITOR_SOURCES_JSON=
# Optional bounded query windows and timeout.
AZURE_MONITOR_BASELINE_WINDOW_HOURS=168
AZURE_MONITOR_OBSERVED_WINDOW_HOURS=24
AZURE_MONITOR_REQUEST_TIMEOUT_MS=15000
AZURE_MONITOR_MAX_RESPONSE_BYTES=4194304

# Optional read-only Microsoft Entra inventory enrichment. ENTRA_* never
# configures employee/API authentication; AUTH_* never configures provider
# inventory. Keep disabled until Application.Read.All has tenant admin consent.
# Agent Identity beta is preview-only and disabled by default.
ENTRA_CONNECTOR_ENABLED=false
ENTRA_CONNECTOR_TENANT_ID=
ENTRA_CONNECTOR_ENVIRONMENT=
# Optional estate-scoped Entra inventory sources. One source can be explicitly
# bound to multiple same-tenant Foundry projects without repeating the query.
# Each source can use default or secretless federated-app credentials.
ENTRA_SOURCES_JSON=
# Optional exact RUNS_AS bindings. Each entry must include estateId plus
# globally scoped foundry:/entra: source IDs, exact tenant/environment/provider,
# and the Foundry project and Entra tenant source object IDs. No binding means
# Entra inventory remains unattributed.
ENTRA_RUNS_AS_BINDINGS_JSON=
ENTRA_CONNECTOR_GRAPH_BASE_URL=https://graph.microsoft.com
ENTRA_CONNECTOR_OWNERS_ENABLED=false
ENTRA_CONNECTOR_APP_ROLES_ENABLED=false
ENTRA_CONNECTOR_AGENT_IDENTITY_PREVIEW=false
ENTRA_CONNECTOR_MAX_PAGES=20
ENTRA_CONNECTOR_MAX_ITEMS=1000
ENTRA_CONNECTOR_REQUEST_TIMEOUT_MS=15000
ENTRA_CONNECTOR_MAX_RETRIES=2
ENTRA_CONNECTOR_MAX_RETRY_AFTER_MS=30000
ENTRA_CONNECTOR_MAX_RESPONSE_BYTES=2000000

# Optional read-only Power Platform ResourceQuery inventory for Copilot Studio
# and Microsoft 365 Copilot Agent Builder. Keep disabled until tenant-scope
# Power Platform Reader (or approved least-privilege read RBAC) is granted.
POWER_PLATFORM_CONNECTOR_ENABLED=false
POWER_PLATFORM_SOURCES_JSON=
POWER_PLATFORM_TENANT_ID=
POWER_PLATFORM_ENVIRONMENT=
POWER_PLATFORM_API_BASE_URL=https://api.powerplatform.com
POWER_PLATFORM_PAGE_SIZE=100
POWER_PLATFORM_MAX_PAGES=20
POWER_PLATFORM_MAX_ITEMS=5000
POWER_PLATFORM_REQUEST_TIMEOUT_MS=15000
POWER_PLATFORM_MAX_RETRIES=2
POWER_PLATFORM_MAX_RETRY_AFTER_MS=30000
POWER_PLATFORM_MAX_RESPONSE_BYTES=2000000

# Microsoft Agent 365 package catalog (read-only, Global Graph v1.0)
AGENT365_CONNECTOR_ENABLED=false
AGENT365_SOURCES_JSON=
AGENT365_TENANT_ID=
AGENT365_ENVIRONMENT=
# Required for legacy scalar configuration. JSON sources must include the same
# explicit user-assigned managed identity client ID in their credential object.
AGENT365_MANAGED_IDENTITY_CLIENT_ID=
AGENT365_GRAPH_BASE_URL=https://graph.microsoft.com
AGENT365_MAX_PAGES=20
AGENT365_MAX_ITEMS=5000
AGENT365_REQUEST_TIMEOUT_MS=15000
AGENT365_MAX_RETRIES=2
# Strict Agent 365 Graph retry-after ceiling; values above 60000 are rejected.
AGENT365_MAX_RETRY_AFTER_MS=30000
# Enforced for each response and across all Agent 365 response bodies per operation.
AGENT365_MAX_RESPONSE_BYTES=2000000
AGENT365_MAX_CONCURRENCY=2
AGENT365_MAX_DURATION_MS=60000

# Microsoft Defender for Cloud Apps alert/activity evidence (read-only, OAuth
# application context only). Keep disabled until licensing/API availability,
# tenant portal URL, and Investigation.Read admin consent are approved.
DEFENDER_CLOUD_APPS_CONNECTOR_ENABLED=false
DEFENDER_CLOUD_APPS_SOURCES_JSON=
DEFENDER_CLOUD_APPS_TENANT_ID=
DEFENDER_CLOUD_APPS_ENVIRONMENT=
DEFENDER_CLOUD_APPS_API_BASE_URL=
DEFENDER_CLOUD_APPS_PORTAL_HOSTNAME=
DEFENDER_CLOUD_APPS_LOOKBACK_HOURS=24
DEFENDER_CLOUD_APPS_PAGE_SIZE=100
DEFENDER_CLOUD_APPS_MAX_PAGES=20
DEFENDER_CLOUD_APPS_MAX_ITEMS=4000
DEFENDER_CLOUD_APPS_REQUEST_TIMEOUT_MS=15000
DEFENDER_CLOUD_APPS_MAX_RETRIES=2
DEFENDER_CLOUD_APPS_MAX_RETRY_AFTER_MS=30000
DEFENDER_CLOUD_APPS_MAX_RESPONSE_BYTES=2000000

# Microsoft Purview tenant sensitivity-label catalog (read-only Graph v1.0,
# Global service only). Keep disabled until tenant-admin SensitivityLabel.Read
# application consent and secretless tenant credentials are approved.
PURVIEW_CONNECTOR_ENABLED=false
PURVIEW_SOURCES_JSON=
PURVIEW_TENANT_ID=
PURVIEW_ENVIRONMENT=
PURVIEW_GRAPH_BASE_URL=https://graph.microsoft.com
PURVIEW_MAX_PAGES=20
PURVIEW_MAX_ITEMS=5000
PURVIEW_REQUEST_TIMEOUT_MS=15000
PURVIEW_MAX_RETRIES=2
PURVIEW_MAX_RETRY_AFTER_MS=30000
PURVIEW_MAX_RESPONSE_BYTES=2000000

# Microsoft Teams organization app catalog metadata (read-only Graph v1.0,
# Global service only). Catalog presence is not installation/distribution
# coverage. Keep disabled until tenant-admin AppCatalog.Read.All application
# consent and secretless tenant credentials are approved.
TEAMS_DISTRIBUTION_CONNECTOR_ENABLED=false
TEAMS_DISTRIBUTION_SOURCES_JSON=
TEAMS_DISTRIBUTION_TENANT_ID=
TEAMS_DISTRIBUTION_ENVIRONMENT=
TEAMS_DISTRIBUTION_GRAPH_BASE_URL=https://graph.microsoft.com
TEAMS_DISTRIBUTION_MAX_PAGES=20
TEAMS_DISTRIBUTION_MAX_ITEMS=5000
TEAMS_DISTRIBUTION_REQUEST_TIMEOUT_MS=15000
TEAMS_DISTRIBUTION_MAX_RETRIES=2
TEAMS_DISTRIBUTION_MAX_RETRY_AFTER_MS=30000
TEAMS_DISTRIBUTION_MAX_RESPONSE_BYTES=2000000

# Authentication (Microsoft Entra ID)
# AUTH_MODE: disabled (default) | mock (test) | jwt (production)
# Keep both gates disabled until the staged activation runbook is approved.
AUTH_MODE=disabled
AGENT_SENTINEL_WRITE_ENABLED=false
# Required when AUTH_MODE=jwt. Values are deployment inputs; do not commit live IDs.
AUTH_TENANT_ID=
AUTH_AUDIENCE=
# Optional exact API trust endpoints. When empty, the tenant-specific Entra v2
# issuer and JWKS discovery endpoint are derived from AUTH_TENANT_ID.
AUTH_ISSUER=
AUTH_JWKS_URI=
# Required public SPA settings when AUTH_MODE=jwt (no client secret).
AUTH_SPA_CLIENT_ID=
# Empty requests only {AUTH_AUDIENCE}/AgentSentinel.Read.
AUTH_SPA_SCOPES=
# Exact portal-registered URLs. Production requires HTTPS; localhost HTTP is
# accepted only for local development. Both URLs must share an origin.
AUTH_SPA_REDIRECT_URI=
AUTH_SPA_POST_LOGOUT_REDIRECT_URI=
# Exact delegated scope claim values accepted by the API.
AUTH_READ_SCOPES=AgentSentinel.Read
AUTH_WRITE_SCOPES=AgentSentinel.Write
