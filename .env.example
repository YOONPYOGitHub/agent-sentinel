# Connector selection; mock is the default.
AGENT_SENTINEL_CONNECTOR=mock
# Required when AGENT_SENTINEL_CONNECTOR=foundry.
FOUNDRY_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/example
FOUNDRY_TENANT_ID=00000000-0000-0000-0000-000000000000
FOUNDRY_ENVIRONMENT=validation

# Optional read-only runtime telemetry connector. Live runtime analysis stays
# typed unknown unless all three required values are injected.
AZURE_MONITOR_WORKSPACE_ID=
AZURE_MONITOR_TENANT_ID=
AZURE_MONITOR_ENVIRONMENT=
# Optional bounded query windows and timeout.
AZURE_MONITOR_BASELINE_WINDOW_HOURS=168
AZURE_MONITOR_OBSERVED_WINDOW_HOURS=24
AZURE_MONITOR_REQUEST_TIMEOUT_MS=15000

# Optional read-only Microsoft Entra inventory enrichment. This is separate
# from AUTH_* user login. Keep disabled until Application.Read.All has tenant
# admin consent. Agent Identity beta is preview-only and disabled by default.
ENTRA_CONNECTOR_ENABLED=false
ENTRA_CONNECTOR_TENANT_ID=
ENTRA_CONNECTOR_ENVIRONMENT=
ENTRA_CONNECTOR_GRAPH_BASE_URL=https://graph.microsoft.com
ENTRA_CONNECTOR_OWNERS_ENABLED=false
ENTRA_CONNECTOR_APP_ROLES_ENABLED=false
ENTRA_CONNECTOR_AGENT_IDENTITY_PREVIEW=false
ENTRA_CONNECTOR_MAX_PAGES=20
ENTRA_CONNECTOR_MAX_ITEMS=1000
ENTRA_CONNECTOR_REQUEST_TIMEOUT_MS=15000
ENTRA_CONNECTOR_MAX_RETRIES=2
ENTRA_CONNECTOR_MAX_RETRY_AFTER_MS=30000

# Authentication (Microsoft Entra ID)
# AUTH_MODE: disabled (default) | mock (test) | jwt (production)
# Keep both gates disabled until the staged activation runbook is approved.
AUTH_MODE=disabled
AGENT_SENTINEL_WRITE_ENABLED=false
# Required when AUTH_MODE=jwt. Values are deployment inputs; do not commit live IDs.
AUTH_TENANT_ID=
AUTH_AUDIENCE=
# Optional exact API trust endpoints. When empty, the tenant-specific Entra v2
# issuer and JWKS discovery endpoint are derived from AUTH_TENANT_ID.
AUTH_ISSUER=
AUTH_JWKS_URI=
# Required public SPA settings when AUTH_MODE=jwt (no client secret).
AUTH_SPA_CLIENT_ID=
# Empty requests only {AUTH_AUDIENCE}/AgentSentinel.Read.
AUTH_SPA_SCOPES=
# Exact portal-registered URLs. Production requires HTTPS; localhost HTTP is
# accepted only for local development. Both URLs must share an origin.
AUTH_SPA_REDIRECT_URI=
AUTH_SPA_POST_LOGOUT_REDIRECT_URI=
# Exact delegated scope claim values accepted by the API.
AUTH_READ_SCOPES=AgentSentinel.Read
AUTH_WRITE_SCOPES=AgentSentinel.Write
