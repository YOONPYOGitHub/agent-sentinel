{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sentinel.example/schemas/active-edge-preflight-input.schema.json",
  "title": "Agent Sentinel active Front Door edge preflight input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "subscriptionId",
    "resourceGroup",
    "profileName",
    "endpointName",
    "frontDoorOrigin",
    "stage"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "subscriptionId": { "$ref": "#/$defs/uuid" },
    "resourceGroup": { "type": "string", "minLength": 1, "maxLength": 90 },
    "profileName": { "type": "string", "minLength": 1, "maxLength": 90 },
    "endpointName": { "type": "string", "minLength": 1, "maxLength": 90 },
    "frontDoorOrigin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#:]+$" },
    "stage": { "enum": ["read-only", "write-readiness"] },
    "reviewedMutationRuleName": { "type": "string", "minLength": 1, "maxLength": 90 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    }
  }
}
