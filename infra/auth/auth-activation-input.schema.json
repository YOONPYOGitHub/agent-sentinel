{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sentinel.example/schemas/auth-activation-input.schema.json",
  "title": "Agent Sentinel read-only authentication activation input",
  "description": "Sanitized, non-secret input for replacement-environment authentication activation preflight.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "production",
    "tenantId",
    "apiClientId",
    "spaClientId",
    "audience",
    "frontDoorOrigin",
    "redirectUri",
    "postLogoutRedirectUri",
    "scopes",
    "roles",
    "estateGrants",
    "writesEnabled",
    "waf",
    "deployment"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "environment": { "const": "replacement-validation" },
    "production": { "const": true },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "apiClientId": { "$ref": "#/$defs/uuid" },
    "spaClientId": { "$ref": "#/$defs/uuid" },
    "audience": {
      "type": "string",
      "pattern": "^api://[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "maxLength": 256
    },
    "issuer": { "type": "string", "format": "uri", "maxLength": 256 },
    "jwksUri": { "type": "string", "format": "uri", "maxLength": 256 },
    "frontDoorOrigin": { "type": "string", "format": "uri", "maxLength": 256 },
    "redirectUri": { "type": "string", "format": "uri", "maxLength": 320 },
    "postLogoutRedirectUri": { "type": "string", "format": "uri", "maxLength": 320 },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "spa"],
      "properties": {
        "read": { "$ref": "#/$defs/scopeList" },
        "write": { "$ref": "#/$defs/scopeList" },
        "spa": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AgentSentinel.Viewer",
          "AgentSentinel.Analyst",
          "AgentSentinel.Approver",
          "AgentSentinel.Administrator"
        ]
      }
    },
    "estateGrants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "tenantId", "environment", "isDefault", "allowedAuthTenantIds"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "tenantId": { "$ref": "#/$defs/uuid" },
          "environment": { "const": "replacement-validation" },
          "isDefault": { "type": "boolean" },
          "allowedAuthTenantIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "writesEnabled": { "const": false },
    "waf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyMode", "mutationRuleName", "mutationRuleAction", "unchanged"],
      "properties": {
        "policyMode": { "const": "Prevention" },
        "mutationRuleName": { "const": "BlockApiMutationPreAuth" },
        "mutationRuleAction": { "const": "Block" },
        "unchanged": { "const": true }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha", "apiImageDigest", "webImageDigest"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "apiImageDigest": { "$ref": "#/$defs/digest" },
        "webImageDigest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "scopeList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,119}$"
      }
    }
  }
}
